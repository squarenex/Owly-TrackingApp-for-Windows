# Default: block almost everything in this public release repo
*

# Keep docs + CI guard
!.gitignore
!README.md
!CHANGELOG.md
!RELEASE_SETUP.md
!.github/
!.github/**

# Allow release binaries folder (exe/dmg only in practice)
!releases/
!releases/**
!releases/**/*.exe
!releases/**/*.dmg
!releases/**/*.sha256
!releases/**/*.txt
!releases/**/.gitkeep

# Never commit source / secrets
.env
.env.*
*.key
*.pem
*.dart
*.swift
*.cpp
*.h
*.php
